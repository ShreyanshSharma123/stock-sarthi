# Stock Saarthi - Backend Environment Variables

# Database
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/stock_saarthi
# For SQLite (development): sqlite:///./stock_saarthi.db

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External APIs (Optional)
NEWSAPI_KEY=your-newsapi-key
FINNHUB_API_KEY=your-finnhub-api-key

# Redis Cache (Optional)
REDIS_URL=redis://localhost:6379

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True
